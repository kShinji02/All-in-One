VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# --- Opcionais (backend; ver docs/SEGURANCA.md, "Configuração de produção") ---
# NODE_ENV=production            # restringe as origens do chat ao discordsays.com da aplicação
# ORIGIN_PROFILE=tunnel          # production | local | tunnel
# CHAT_EXTRA_ORIGINS=            # origens HTTPS exatas extras, separadas por vírgula
# TRUST_PROXY=                   # nº de proxies confiáveis à frente do Express (ex.: 1); nunca "true"
# TOKEN_RATE_LIMIT=120           # trocas de código OAuth por minuto, por IP (proxy do Discord: IP compartilhado)
# TOKEN_GLOBAL_RATE_LIMIT=240    # trocas de código OAuth por minuto, no total (por instância)
# PORT=3001                      # porta do backend (o Render define a sua; não defina lá)
# HOST=                          # interface; padrão 0.0.0.0 em produção/Render
# PROXY_DIAGNOSTICS=true         # registra só a contagem do X-Forwarded-For (ver docs/DEPLOY-RENDER.md)

# --- Aceite dos documentos legais (backend; ver docs/ACEITE-LEGAL.md) ---
# DATABASE_URL=                  # PostgreSQL (Neon) com TLS; obrigatório em produção. NUNCA commite o valor real.
# LEGAL_STORE=memory             # só desenvolvimento local, sem banco; recusado em produção
# LEGAL_TERMS_URL=               # URL HTTPS dos Termos de Uso (padrão: GitHub Pages previsto)
# LEGAL_PRIVACY_URL=             # URL HTTPS da Política de Privacidade
