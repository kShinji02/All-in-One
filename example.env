VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN

# --- Opcionais (backend; ver docs/SEGURANCA.md, "Configuração de produção") ---
# NODE_ENV=production            # restringe as origens do chat ao discordsays.com da aplicação
# ORIGIN_PROFILE=tunnel          # production | local | tunnel
# CHAT_EXTRA_ORIGINS=            # origens HTTPS exatas extras, separadas por vírgula
# TRUST_PROXY=                   # nº de proxies confiáveis à frente do Express (ex.: 1); nunca "true"
# TOKEN_RATE_LIMIT=10            # trocas de código OAuth por minuto, por cliente
# TOKEN_GLOBAL_RATE_LIMIT=120    # trocas de código OAuth por minuto, no total
